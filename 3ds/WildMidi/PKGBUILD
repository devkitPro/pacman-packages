# Maintainer: WinterMute <davem@devkitpro.org>
# Contributor: oreo639 <oreo6391@gmail.com>

pkgname=3ds-wildmidi
pkgver=0.5.0
pkgrel=1
pkgdesc='Core softsynth library that can be used with other applications.'
arch=('any')
url='https://www.mindwerks.net/projects/wildmidi/'
license=('LGPL')
options=(!strip libtool staticlibs)
source=( "https://github.com/Mindwerks/wildmidi/archive/wildmidi-${pkgver}.tar.gz" "wildmidi-0.5.0.patch")
groups=('3ds-portlibs')
makedepends=('3ds-cmake' 'dkp-toolchain-vars')
sha256sums=('2164396d5fe80153fd2af9764fcd991883d06fbf1fdfd96efbc99eed21ed1a2f'
            '1fefd1957f24f84698eec8049985f2ac3561c01f0c0d0c9f7170db54efb5431c')

prepare() {
  patch -d wildmidi-wildmidi-$pkgver -i $srcdir/wildmidi-0.5.0.patch
}

build() {
  source /opt/devkitpro/3dsvars.sh

  cmake \
    -S wildmidi-wildmidi-$pkgver \
    -B build \
    -DCMAKE_TOOLCHAIN_FILE=$DEVKITPRO/cmake/3ds.cmake \
    -DCMAKE_BUILD_TYPE=RelWithDebInfo \
    -DBUILD_SHARED_LIBS=OFF \
    -DBUILD_TESTING=OFF \
    -DWANT_STATIC=ON \
    -DWANT_PLAYER=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
