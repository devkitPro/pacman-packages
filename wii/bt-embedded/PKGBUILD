pkgname=bt-embedded
pkgver=0.2
pkgrel=1
pkgdesc='Bluetooth classic library for embedded devices'
arch=('any')
url='https://github.com/embedded-game-controller/bt-embedded'
license=('BSD-3-Clause')
options=(!strip libtool staticlibs)
makedepends=('catnip')
depends=('libogc')
groups=('wii-portlibs')

source=(
  "bt-embedded-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz"
)

build() {
  cd bt-embedded-${pkgver}
  catnip -t wii
}

package() {
  cd bt-embedded-${pkgver}
  DESTDIR=${pkgdir} catnip install
}

sha256sums=('3c0001e4a67a0c84c5b4c386aca32b983e6294016d5d7fbb5cde1534ffe51fe3')
